{
  "expo": {
    "name": "Citizen Wallet",
    "slug": "citizen-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "citizenwallet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.citizenwallet.app"
    },
    "android": {
      "package": "com.citizenwallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#007A78",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Pozwól aplikacji Citizen Wallet na skanowanie kodów kreskowych i QR aparatem.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pozwól aplikacji na dostęp do zdjęć, aby dodać zdjęcie paragonu.",
          "cameraPermission": "Pozwól aplikacji na zrobienie zdjęcia paragonu."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pozwól aplikacji na dostęp do lokalizacji, aby znaleźć najbliższe punkty zbiórki."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007A78"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
